# Généré par scripts/prepare_arch_build.py ; ne pas utiliser ce modèle directement.
pkgname=sambapilot
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc='Diagnostic et préparation de partages Samba avec terminal et interface GTK4'
arch=('any')
# Aucune licence choisie dans le projet : à définir avant distribution publique.
depends=('python' 'gtk4>=4.10' 'python-gobject')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('samba: contrôle explicite de configuration avec testparm')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    python -m build --wheel --no-isolation
}

check() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    python -B scripts/check.py
    python -B scripts/run_tests.py
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 packaging/arch/sambapilot.desktop \
        "${pkgdir}/usr/share/applications/io.github.sambapilot.SambaPilot.desktop"
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "sambapilot/assets/icons/hicolor/${size}x${size}/apps/io.github.sambapilot.SambaPilot.png" \
            "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/io.github.sambapilot.SambaPilot.png"
    done
}
